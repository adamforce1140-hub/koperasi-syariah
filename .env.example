APP_NAME="Koperasi Syariah"
APP_ENV=local
APP_KEY=
# B-2 — WAJIB `false`. Dengan `true`, Laravel menampilkan stack trace lengkap
# (path berkas, potongan kode, nilai variabel) dan Ignition membuka endpoint
# diagnostik ke publik. Untuk pengembangan lokal, salin berkas ini menjadi
# `.env` lalu ubah nilainya menjadi `true` HANYA di mesin pengembang.
APP_DEBUG=false
APP_URL=http://localhost

# ── A-01: permukaan eksekusi Ignition ────────────────────────────────────────
# Bila tidak diset, Ignition mengaktifkan "runnable solutions"
# (/_ignition/execute-solution) otomatis saat APP_DEBUG=true + APP_ENV=local.
# Selalu setel `false`, terutama di produksi (defensif berlapis).
IGNITION_ENABLE_RUNNABLE_SOLUTIONS=false

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=koperasi_syariah
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Enkripsi payload sesi. Biarkan `true` — nilai inilah yang dipakai
# `config/session.php` secara bawaan. Hanya setel `false` bila penyimpanan
# sesi Anda tidak mampu menangani payload terenkripsi.
SESSION_ENCRYPT=true
# Kirim cookie sesi hanya melalui HTTPS (mitigasi penyadapan — UU PDP
# No. 27/2022). Biarkan `true`; matikan HANYA untuk pengembangan lokal
# berbasis HTTP (mis. Laragon tanpa TLS).
SESSION_SECURE_COOKIE=true
# Kosong = tidak ada proxy tepercaya (akses langsung). Isi `*` bila aplikasi
# selalu berada di belakang load balancer/proxy terkelola.
TRUSTED_PROXIES=

# ── Header keamanan HTTP (UU PDP No. 27/2022) ────────────────────────────────
# Lihat docs/TAHAP10-KEAMANAN-DATA-UU-PDP.md.
# CSP hanya mengizinkan asal sendiri. Font, CSS, dan JS pihak ketiga WAJIB
# disimpan di public/ (lihat public/css/figtree.css, public/vendor/), karena
# rujukan ke CDN luar akan diblokir peramban saat header ini ditegakkan.
KEAMANAN_CSP_AKTIF=true
# `true` = header Content-Security-Policy ditegakkan (memutus XSS inline).
# `false` = Content-Security-Policy-Report-Only, hanya melaporkan tanpa
# memblokir — pakai sementara saat aktivasi bertahap, jangan di produksi.
KEAMANAN_CSP_ENFORCE=true
# HSTS hanya berlaku pada koneksi HTTPS; biarkan `false` untuk Laragon lokal.
KEAMANAN_HSTS_AKTIF=false
KEAMANAN_HSTS_MAX_AGE=31536000

# ── Kebijakan kekuatan password (UU PDP No. 27/2022) ─────────────────────────
# Berlaku saat membuat pengguna baru / mengganti password, bukan saat login.
# Bawaan berbeda per lingkungan: local/testing 8 karakter tanpa syarat simbol;
# produksi 12 karakter + huruf besar + angka + simbol.
#
# JANGAN menulis `KUNCI=` (kosong) untuk kunci ini: `env()` mengembalikan ""
# dan `(int) ""` = 0 sehingga panjang minimum menjadi NOL karakter. Biarkan
# baris berikut TETAP TERKOMENTAR bila ingin memakai bawaan per lingkungan;
# hapus tanda `#` dan isi nilainya hanya bila ingin menyeragamkan.
# KEAMANAN_PASSWORD_MIN=12
# KEAMANAN_PASSWORD_HURUF_BESAR=true
# KEAMANAN_PASSWORD_ANGKA=true
# KEAMANAN_PASSWORD_SIMBOL=true
# Tolak password yang pernah bocor (butuh koneksi internet ke pwnedpasswords).
KEAMANAN_PASSWORD_CEK_BOCOR=false

# Jejak audit perubahan data pribadi (append-only + rantai hash). Biarkan
# `true` — UU PDP mewajibkan kemampuan menelusuri perubahan data pribadi.
KEAMANAN_AUDIT_PII=true

# Mesin sinkronisasi real-time ("Denyut"). Lihat docs/TAHAP8-REAL-TIME.md.
# DENYUT_SSE / DENYUT_TUNGGU mematikan jalur cepat; klien otomatis jatuh ke
# polling adaptif bila keduanya false. DENYUT_LOG_LEVEL mengatur kanal log
# khusus "denyut" (storage/logs/denyut.log).
DENYUT_SSE=true
DENYUT_TUNGGU=true
DENYUT_LOG_LEVEL=warning

# Kredensial demo (HANYA untuk non-produksi). Panel "Akses Cepat Demo Akun"
# pada halaman login dan UserSeeder membaca nilai ini. Biarkan KOSONG di
# produksi — panel otomatis tersembunyi dan akun demo tidak akan dibuat.
DEMO_LOGIN_ENABLED=
DEMO_USER_PASSWORD=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# B-5 — `log` hanya untuk pengembangan: surel TIDAK terkirim, hanya ditulis ke
# storage/logs/laravel.log. Di produksi ganti menjadi `smtp` dan isi kredensial
# di bawah, agar notifikasi & tautan reset kata sandi benar-benar sampai.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@koperasi-syariah.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cadangan basis data (R6). Kunci base64 dari tepat 32 byte:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Bila kosong, kunci diturunkan dari APP_KEY via HKDF. Simpan kunci ini
# terpisah dari server — tanpa kunci, cadangan tidak dapat dipulihkan.
BACKUP_ENKRIPSI=true
BACKUP_ENCRYPTION_KEY=
# Direktori berkas cadangan. Kosong = storage/app/backups.
BACKUP_DIREKTORI=
# Salinan offsite (disk kedua, USB, atau share jaringan). Kosong = tidak
# menyalin. Bila diisi, setiap cadangan disalin ke sini dan kegagalan
# menyalin memicu notifikasi ke pengurus — cadangan yang hanya ada di satu
# disk tidak melindungi dari kerusakan disk itu sendiri.
BACKUP_SALINAN_DIREKTORI=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
